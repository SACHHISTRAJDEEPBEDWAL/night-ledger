# Copy to .env and edit. Every value here is optional — the app boots and
# scans with none of them set.

# ── access ───────────────────────────────────────────────────────────────
# Leave blank for an open URL. Set a long random string on a public deploy;
# open the site once as  https://your-app/?token=THAT_STRING  and the browser
# keeps a cookie, so the bookmark on your phone just works after that.
ACCESS_TOKEN=

# ── price feed ───────────────────────────────────────────────────────────
# yahoo    = free, no account, intraday lags the exchange by ~15 min
# angelone = live tick-by-tick over WebSocket (needs a broker account)
FEED=yahoo

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── cadence ──────────────────────────────────────────────────────────────
MOMENTUM_POLL_SECONDS=30
VCP_SCAN_MINUTES=30
HISTORY_CACHE_MINUTES=60

# ── momentum trigger ─────────────────────────────────────────────────────
MOMENTUM_WINDOW_MINUTES=15
MOMENTUM_THRESHOLD_PCT=2.0
MOMENTUM_COOLDOWN_MINUTES=30

# ── VCP shape ────────────────────────────────────────────────────────────
MIN_CONTRACTIONS=2
MAX_CONTRACTIONS=6
MAX_FIRST_CONTRACTION_PCT=35
MAX_FINAL_CONTRACTION_PCT=12
CONTRACTION_SHRINK_RATIO=0.80
MIN_BASE_DAYS=15
MAX_BASE_DAYS=130
VOLUME_DRYUP_RATIO=0.75
PIVOT_WINDOW=5

# ── Stage 2 trend template ───────────────────────────────────────────────
MIN_PCT_ABOVE_52W_LOW=25
MAX_PCT_BELOW_52W_HIGH=25
SMA200_SLOPE_LOOKBACK=22
RS_BENCHMARK=^NSEI
MIN_RS_SCORE=0

# ── optional phone push (the dashboard already streams alerts live) ──────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
